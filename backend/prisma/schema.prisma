generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  todos    Todo[]
}

model Todo {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  status      String @default("todo") // todo, in progress, done
  userId      Int
  user        User   @relation(fields: [userId], references: [id])
}